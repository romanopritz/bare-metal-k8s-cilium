---
apiVersion: kubeadm.k8s.io/v1beta3
kind: JoinConfiguration
discovery:
  bootstrapToken:
    token: {{ join_token }}
    apiServerEndpoint: {{ first_cp_ip }}:{{ apiserver_port }}
    caCertHashes:
      - sha256:{{ ca_cert_hash }}
nodeRegistration:
  name: {{ node_name }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    node-ip: {{ node_ip }}
