#!/usr/sbin/nft -f
# Managed by Ansible. Stateful firewall for the Kubernetes cluster nodes.
#
# Strategy:
#  - default deny on input
#  - allow loopback, established/related, ICMP
#  - allow SSH from ssh_allowlist
#  - allow 80/443 from world
#  - allow all inter-cluster traffic between the 5 node IPs
#  - allow Cilium overlay/encap traffic (VXLAN/WireGuard) between cluster IPs
#  - the forward chain is permissive: kube-proxy/Cilium manage container traffic

flush ruleset

table inet filter {
    set cluster_v4 {
        type ipv4_addr
        elements = {
{% for h in groups['cluster'] %}
            {{ hostvars[h].node_ip }}{{ "," if not loop.last else "" }}
{% endfor %}
        }
    }

    set ssh_allow_v4 {
        type ipv4_addr
        flags interval
        elements = {
{% for cidr in ssh_allowlist %}
            {{ cidr }}{{ "," if not loop.last else "" }}
{% endfor %}
        }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        iif "lo" accept

        # ICMP
        ip  protocol icmp   icmp   type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
        ip6 nexthdr  icmpv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

        # SSH
        tcp dport 22 ip saddr @ssh_allow_v4 accept

        # Public-facing app traffic
{% for p in public_tcp_ports %}
        tcp dport {{ p }} accept
{% endfor %}

        # Inter-cluster: allow everything between known node IPs (simpler than per-port and Cilium uses many ephemeral ports for health/probes)
        ip saddr @cluster_v4 accept

        # Pod and tunnel interfaces: trust traffic from Cilium-managed devices
        iifname { "cilium_*", "lxc*", "cilium_host", "cilium_net", "cilium_vxlan", "cilium_wg0" } accept

        counter comment "default-drop"
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
